# Referência apenas: k6 NÃO carrega este arquivo automaticamente.
# Passe -e BASE_URL=http://127.0.0.1:8080 -e TARGET_PATH=/health no k6 run.
# Ou exporte as variáveis no shell (veja README para macOS/Linux e PowerShell).
# Exclusivas dos novos exemplos Spike/Breakpoint; destino local ou autorizado.
BASE_URL=
TARGET_PATH=/health
PRE_ALLOCATED_VUS=20
MAX_VUS=100
SPIKE_BASE_RATE=2
SPIKE_PEAK_RATE=20
SPIKE_INITIAL_SECONDS=30
SPIKE_RAMP_SECONDS=2
SPIKE_PEAK_SECONDS=20
SPIKE_RECOVERY_SECONDS=60
BREAKPOINT_START_RATE=2
BREAKPOINT_INCREMENT=5
BREAKPOINT_MAX_RATE=22
BREAKPOINT_LEVEL_SECONDS=20
BREAKPOINT_RAMP_SECONDS=2

# Reservadas para evolução futura; não são consumidas pelos exemplos.
ENV=local
TOKEN=
